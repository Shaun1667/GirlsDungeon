# 기본: 텍스트 자동 판별
* text=auto

# Unity YAML 에셋 — 줄바꿈 고정 (OS가 달라도 줄바꿈만 바뀐 변경이 생기지 않게)
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.meta text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.physicMaterial text eol=lf
*.inputactions text eol=lf
*.shadergraph text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf

# 코드 · 데이터 · 문서
*.cs text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.md text eol=lf

# 바이너리
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.psd binary
*.fbx binary
*.glb binary
*.wav binary
*.mp3 binary
*.ogg binary
*.ttf binary
*.otf binary
*.dll binary
